# Data — 205 GB, all public and re-fetchable by the scripts in this repo
data/
tiles/
tiles_s4/
raw_10x/
BreaKHis_v1/
*.tif
*.tif.gz
*.tar.gz
*.svs
*.h5
*.h5ad

# Cached arrays and embeddings (regenerable; hundreds of MB to GB)
*.npz
!evidence/*.npz

# Model checkpoints (regenerable)
ckpt/
*.pt
*.pth

# Logs and run output -- but evidence/logs holds the raw output backing the
# numbers in the READMEs, so those are whitelisted
*.log
!evidence/logs/*.log
out/
verify_results.json
!evidence/verify_results.json

# Python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# macOS
.DS_Store

# November 2026 update: what its scripts download or write next to themselves.
# The result files that back its README are versioned under update_2026_11/results/.
pathology-fm/update_2026_11/**/*.npy
pathology-fm/update_2026_11/*.json
pathology-fm/update_2026_11/hest/*.json
pathology-fm/update_2026_11/hest/bench_data/
pathology-fm/update_2026_11/hest/emb/
pathology-fm/update_2026_11/stflow_cmp/*.json
pathology-fm/update_2026_11/stflow_cmp/STFlow/
